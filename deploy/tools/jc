#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${KUBECONFIG:-}" ]]; then
  for config in /home/ubuntu/.kube/config "$HOME/.kube/config"; do
    if [[ -r "$config" ]]; then
      export KUBECONFIG=$config
      break
    fi
  done
fi

if (($# > 1)); then
  echo 'Usage: jc [p|d|a]' >&2
  exit 2
fi

case "${1:-p}" in
  p|prod)
    exec kubectl courses --env prod
    ;;
  d|dev)
    exec kubectl courses --env dev
    ;;
  a|all)
    exec kubectl courses
    ;;
  *)
    echo 'Usage: jc [p|d|a]' >&2
    exit 2
    ;;
esac
