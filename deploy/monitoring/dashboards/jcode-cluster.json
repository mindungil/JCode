    {
      "type": "table",
      "id": 11,
      "title": "최근 1시간 재시작 많은 파드",
      "description": "재시작이 있었던 파드만",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(15, sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[1h])) > 0)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "namespace": "네임스페이스",
              "pod": "파드",
              "Value": "1시간 재시작"
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "-"
        },
        "overrides": []
