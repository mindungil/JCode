        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (course_code, clss) (jcode_router_websocket_users{kind!=\"inspector\"})",
