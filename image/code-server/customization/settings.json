{
  "workbench.colorTheme": "Default Dark Modern",
  "workbench.startupEditor": "none",
  "workbench.tips.enabled": false,
  "workbench.welcomePage.walkthroughs.openOnInstall": false,

  "workbench.colorCustomizations": {
    "titleBar.activeBackground": "#191A21",
    "titleBar.activeForeground": "#F8F8F2",
    "activityBar.background": "#191A21",
    "activityBar.foreground": "#BD93F9",
    "activityBar.inactiveForeground": "#6272A4",
    "activityBarBadge.background": "#FF79C6",
    "sideBar.background": "#21222C",
    "sideBar.foreground": "#F8F8F2",
    "sideBarTitle.foreground": "#BD93F9",
    "editor.background": "#282A36",
    "editor.foreground": "#F8F8F2",
    "editor.selectionBackground": "#44475A",
    "editor.lineHighlightBackground": "#2C2D3A",
    "editorCursor.foreground": "#50FA7B",
    "editorLineNumber.foreground": "#6272A4",
    "editorLineNumber.activeForeground": "#F8F8F2",
    "tab.activeBackground": "#282A36",
    "tab.inactiveBackground": "#21222C",
    "tab.activeBorderTop": "#BD93F9",
    "tab.border": "#191A21",
    "terminal.background": "#1E1F29",
    "terminal.foreground": "#F8F8F2",
    "terminal.ansiGreen": "#50FA7B",
    "terminal.ansiRed": "#FF5555",
    "terminal.ansiYellow": "#F1FA8C",
    "terminal.ansiBlue": "#BD93F9",
    "terminal.ansiMagenta": "#FF79C6",
    "terminal.ansiCyan": "#8BE9FD",
    "statusBar.background": "#191A21",
    "statusBar.foreground": "#6272A4",
    "panel.background": "#1E1F29",
    "panel.border": "#44475A",
    "list.activeSelectionBackground": "#44475A",
    "list.hoverBackground": "#2C2D3A",
    "focusBorder": "#BD93F9",
    "button.background": "#BD93F9",
    "button.foreground": "#282A36",
    "badge.background": "#FF79C6",
    "badge.foreground": "#F8F8F2",
    "scrollbarSlider.background": "rgba(189, 147, 249, 0.2)",
    "scrollbarSlider.hoverBackground": "rgba(189, 147, 249, 0.4)",
    "scrollbarSlider.activeBackground": "rgba(189, 147, 249, 0.5)"
  },

  "editor.fontFamily": "'JetBrains Mono', 'Noto Sans KR', monospace",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.6,
  "editor.minimap.enabled": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.renderWhitespace": "selection",
  "editor.tabSize": 4,
  "editor.wordWrap": "off",

  "terminal.integrated.fontFamily": "'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,

  "window.menuBarVisibility": "compact",
  "window.commandCenter": false,
  "window.title": "${dirty}${activeEditorShort}${separator}JCode",

  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false,

  "git.enabled": false,
  "git.decorations.enabled": false,

  "extensions.autoUpdate": false,
  "extensions.autoCheckUpdates": false,
  "update.showReleaseNotes": false,
  "telemetry.telemetryLevel": "off",

  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 1000,

  "breadcrumbs.enabled": true
}
